# --- Lokale Entwicklung (Standard) ---
# SQLite-Datei; wird automatisch angelegt. Für Postgres stattdessen eine postgres://-Adresse eintragen.
DATABASE_URL=file:./gartenverein.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Öffentliche Adresse der Website (Sitemap, Vorschau, Open Graph, Kalender).
# Auf Vercel optional: ohne Angabe wird die Vercel-Adresse verwendet.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Vercel (werden von den Integrationen «Neon» und «Blob» gesetzt) ---
# DATABASE_URL=postgres://…            (Neon, «pooled»)
# DATABASE_URL_UNPOOLED=postgres://…   (Neon, direkt; wird für Migrationen genutzt)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_…   (ohne Token werden Dateien lokal gespeichert)
